# Server
PORT=4000
NODE_ENV=production
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API (your frontend URL)
CORS_ORIGINS=https://globalpath-frontend-production.up.railway.app,http://localhost:8443
# Where db.json and uploads are stored. On Railway, mount a volume at /data and set this to /data
DATA_DIR=./data
MAX_UPLOAD_MB=10

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@globalpath.co.za
ADMIN_PASSWORD=
ADMIN_NAME=GlobalPath Admin

# Email (optional — without SMTP_HOST, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GlobalPath Immigration <hello@globalpath.co.za>
NOTIFY_EMAIL=hello@globalpath.co.za
